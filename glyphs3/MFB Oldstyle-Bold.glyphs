lookup MFBGreekSmallcapsSuppressMarks {
    lookupflag UseMarkFilteringSet @MFBGreekSmallcapsAccentInputs;
    sub @MFBGreekSmallcapsBases @MFBGreekSmallcapsHide' by mfbGreekSmallcapsNoAccent.sc;
    sub @MFBGreekSmallcapsBases @MFBGreekSmallcapsKeepDiaeresis' by dieresiscomb.sc;
} MFBGreekSmallcapsSuppressMarks;

@MFBGreekSmallcapsEditorialMarks = [ypogegrammenicomb dotbelowcomb];
lookup MFBGreekSmallcapsYpoToDot {
  sub ypogegrammenicomb by dotbelowcomb;
} MFBGreekSmallcapsYpoToDot;
lookup MFBGreekSmallcapsDotToYpo {
  sub dotbelowcomb by ypogegrammenicomb;
} MFBGreekSmallcapsDotToYpo;
lookup MFBGreekSmallcapsEditorialDotOrder {
  lookupflag UseMarkFilteringSet @MFBGreekSmallcapsEditorialMarks;
  sub @MFBGreekSmallcapsBases ypogegrammenicomb' lookup MFBGreekSmallcapsYpoToDot dotbelowcomb' lookup MFBGreekSmallcapsDotToYpo;
} MFBGreekSmallcapsEditorialDotOrder;

lookup MFBGreekSmallcapsAdscript {
    lookupflag UseMarkFilteringSet @MFBGreekSmallcapsYpo;
    sub @MFBGreekSmallcapsBases ypogegrammenicomb' by iota.sc;
} MFBGreekSmallcapsAdscript;";
name = "MFB Greek Smallcaps";
