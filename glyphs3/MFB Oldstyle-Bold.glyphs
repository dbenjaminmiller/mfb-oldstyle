{
code = "@MFBGreekAboveDiaeresisRecoveryMarks = [dieresiscomb];
lookup MFBGreekAboveDiaeresisUnpack {
  lookupflag 0;
  sub Iotatonos by Iota acutecomb;
  sub Iotaoxia by Iota acutecomb;
  sub Iotavaria by Iota gravecomb;
  sub Iota.perispomenicomb.polytonic by Iota perispomenicomb;
  sub Upsilontonos by Upsilon acutecomb;
  sub Upsilonoxia by Upsilon acutecomb;
  sub Upsilonvaria by Upsilon gravecomb;
  sub Upsilon.perispomenicomb.polytonic by Upsilon perispomenicomb;
} MFBGreekAboveDiaeresisUnpack;
lookup MFBGreekAboveDiaeresisRecovery {
  lookupflag UseMarkFilteringSet @MFBGreekAboveDiaeresisRecoveryMarks;
  sub Iotatonos' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Iotaoxia' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Iotavaria' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Iota.perispomenicomb.polytonic' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Upsilontonos' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Upsilonoxia' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Upsilonvaria' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
  sub Upsilon.perispomenicomb.polytonic' lookup MFBGreekAboveDiaeresisUnpack dieresiscomb;
} MFBGreekAboveDiaeresisRecovery;
lookup MFBGreekAboveDiaeresisQuantitySwap {
  lookupflag 0;
  sub [Iota Upsilon] [acutecomb gravecomb perispomenicomb]' lookup MFBGreekLengthSwap0 [macroncomb brevecomb] dieresiscomb;
} MFBGreekAboveDiaeresisQuantitySwap;
lookup MFBGreekAboveDiaeresisQuantityExpand {
  lookupflag 0;
  sub [Iota Upsilon] [mfbGreekSwap03010304.ccmp mfbGreekSwap03010306.ccmp mfbGreekSwap03000304.ccmp mfbGreekSwap03000306.ccmp mfbGreekSwap03420304.ccmp mfbGreekSwap03420306.ccmp]' lookup MFBGreekLengthExpand0 dieresiscomb;
} MFBGreekAboveDiaeresisQuantityExpand;
lookup MFBGreekAboveDiaeresisCombine {
  lookupflag UseMarkFilteringSet @MFBGreekDiaeresis;
  sub acutecomb dieresiscomb by dieresiscomb_acutecomb;
  sub dieresiscomb acutecomb by dieresiscomb_acutecomb;
  sub gravecomb dieresiscomb by dieresiscomb_gravecomb;
  sub dieresiscomb gravecomb by dieresiscomb_gravecomb;
  sub perispomenicomb dieresiscomb by dieresiscomb_perispomenicomb;
  sub dieresiscomb perispomenicomb by dieresiscomb_perispomenicomb;
} MFBGreekAboveDiaeresisCombine;";
name = "MFB Greek Above Diaeresis Recovery";
