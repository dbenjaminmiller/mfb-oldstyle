lookup MFBGreekAllcapsSuppressMarks {
    lookupflag UseMarkFilteringSet @MFBGreekAllcapsAccentInputs;
    sub @MFBGreekAllcapsBases @MFBGreekAllcapsHide' by mfbGreekAllcapsNoAccent.allcaps;
    sub @MFBGreekAllcapsBases @MFBGreekAllcapsKeepDiaeresis' by dieresiscomb.allcaps;
} MFBGreekAllcapsSuppressMarks;

@MFBGreekAllcapsEditorialMarks = [ypogegrammenicomb dotbelowcomb];
lookup MFBGreekAllcapsYpoToDot {
  sub ypogegrammenicomb by dotbelowcomb;
} MFBGreekAllcapsYpoToDot;
lookup MFBGreekAllcapsDotToYpo {
  sub dotbelowcomb by ypogegrammenicomb;
} MFBGreekAllcapsDotToYpo;
lookup MFBGreekAllcapsEditorialDotOrder {
  lookupflag UseMarkFilteringSet @MFBGreekAllcapsEditorialMarks;
  sub @MFBGreekAllcapsBases ypogegrammenicomb' lookup MFBGreekAllcapsYpoToDot dotbelowcomb' lookup MFBGreekAllcapsDotToYpo;
} MFBGreekAllcapsEditorialDotOrder;

lookup MFBGreekAllcapsAdscript {
    lookupflag UseMarkFilteringSet @MFBGreekAllcapsYpo;
    sub @MFBGreekAllcapsBases ypogegrammenicomb' by Iota;
