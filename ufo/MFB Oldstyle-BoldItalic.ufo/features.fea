lookup MFBGreekCapitalFallback {
    lookupflag UseMarkFilteringSet @MFBGreekPreposed;
    sub @MFBGreekCapitals acutecomb' by acutecomb.case;
    sub @MFBGreekCapitals commaabovecomb' by commaabovecomb.case;
    sub @MFBGreekCapitals commaabovecomb_acutecomb' by commaabovecomb_acutecomb.case;
    sub @MFBGreekCapitals commaabovecomb_gravecomb' by commaabovecomb_gravecomb.case;
    sub @MFBGreekCapitals commaabovecomb_perispomenicomb' by commaabovecomb_perispomenicomb.case;
    sub @MFBGreekCapitals commareversedabovecomb' by commareversedabovecomb.case;
    sub @MFBGreekCapitals commareversedabovecomb_acutecomb' by commareversedabovecomb_acutecomb.case;
    sub @MFBGreekCapitals commareversedabovecomb_gravecomb' by commareversedabovecomb_gravecomb.case;
    sub @MFBGreekCapitals commareversedabovecomb_perispomenicomb' by commareversedabovecomb_perispomenicomb.case;
    sub @MFBGreekCapitals gravecomb' by gravecomb.case;
    sub @MFBGreekCapitals perispomenicomb' by perispomenicomb.case;
} MFBGreekCapitalFallback;

# Prefix: MFB Greek Initial Length Spacing
@MFBGreekInitialLengthInputs = [brevecomb.grek macroncomb.grek];
lookup MFBGreekInitialLengthSpacing {
    lookupflag UseMarkFilteringSet @MFBGreekInitialLengthInputs;
    sub Alphadasiaperispomeni' macroncomb.grek by Alphadasiaperispomeni.lengthmacron;
    sub Alphadasiaperispomeni' brevecomb.grek by Alphadasiaperispomeni.lengthbreve;
    sub Alphadasiaperispomeniprosgegrammeni' macroncomb.grek by Alphadasiaperispomeniprosgegrammeni.lengthmacron;
    sub Alphadasiaperispomeniprosgegrammeni' brevecomb.grek by Alphadasiaperispomeniprosgegrammeni.lengthbreve;
    sub Alphapsiliperispomeni' macroncomb.grek by Alphapsiliperispomeni.lengthmacron;
    sub Alphapsiliperispomeni' brevecomb.grek by Alphapsiliperispomeni.lengthbreve;
    sub Alphapsiliperispomeniprosgegrammeni' macroncomb.grek by Alphapsiliperispomeniprosgegrammeni.lengthmacron;
    sub Alphapsiliperispomeniprosgegrammeni' brevecomb.grek by Alphapsiliperispomeniprosgegrammeni.lengthbreve;
} MFBGreekInitialLengthSpacing;

lookup MFBGreekInitialLengthUndo {
    lookupflag 0;
    sub Alphadasiaperispomeni.lengthmacron by Alphadasiaperispomeni;
    sub Alphadasiaperispomeni.lengthbreve by Alphadasiaperispomeni;
    sub Alphadasiaperispomeniprosgegrammeni.lengthmacron by Alphadasiaperispomeniprosgegrammeni;
    sub Alphadasiaperispomeniprosgegrammeni.lengthbreve by Alphadasiaperispomeniprosgegrammeni;
    sub Alphapsiliperispomeni.lengthmacron by Alphapsiliperispomeni;
    sub Alphapsiliperispomeni.lengthbreve by Alphapsiliperispomeni;
    sub Alphapsiliperispomeniprosgegrammeni.lengthmacron by Alphapsiliperispomeniprosgegrammeni;
    sub Alphapsiliperispomeniprosgegrammeni.lengthbreve by Alphapsiliperispomeniprosgegrammeni;
} MFBGreekInitialLengthUndo;

# Prefix: MFB Greek Stem Archaic Smallcaps
lookup MFBStemArchaicLower {
  sub heta by heta.sc;
  sub archaicsampi by archaicsampi.sc;
  sub pamphyliandigamma by pamphyliandigamma.sc;
  sub digamma by digamma.sc;
  sub san by san.sc;
} MFBStemArchaicLower;
lookup MFBStemArchaicUpper {
  sub Heta by heta.sc;
  sub Archaicsampi by archaicsampi.sc;
  sub Pamphyliandigamma by pamphyliandigamma.sc;
  sub Digamma by digamma.sc;
  sub San by san.sc;
} MFBStemArchaicUpper;

# Prefix: MFB Greek Curved Archaic Smallcaps
lookup MFBCurvedArchaicSmallcapsLower {
  sub kaiSymbol by kaiSymbol.sc;
  sub koppaArchaic by koppaArchaic.sc;
  sub stigma by stigma.sc;
  sub koppa by koppa.sc;
  sub sampi by sampi.sc;
  sub sho by sho.sc;
} MFBCurvedArchaicSmallcapsLower;
lookup MFBCurvedArchaicSmallcapsUpper {
  sub KaiSymbol by kaiSymbol.sc;
  sub KoppaArchaic by koppaArchaic.sc;
  sub Stigma by stigma.sc;
  sub Koppa by koppa.sc;
  sub Sampi by sampi.sc;
  sub Sho by sho.sc;
} MFBCurvedArchaicSmallcapsUpper;

