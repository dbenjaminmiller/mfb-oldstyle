lookup MFBGreekAllcapsSuppressMarks {
    lookupflag UseMarkFilteringSet @MFBGreekAllcapsAccentInputs;
    sub @MFBGreekAllcapsBases @MFBGreekAllcapsHide' by mfbGreekAllcapsNoAccent.allcaps;
    sub @MFBGreekAllcapsBases @MFBGreekAllcapsKeepDiaeresis' by dieresiscomb.grek.allcaps;
} MFBGreekAllcapsSuppressMarks;

lookup MFBGreekAllcapsAdscript {
    lookupflag UseMarkFilteringSet @MFBGreekAllcapsYpo;
    sub @MFBGreekAllcapsBases ypogegrammenicomb' by Iota.spacingadscript.allcaps;
} MFBGreekAllcapsAdscript;

