lookup MFBGreekPunctuationLocal {
    sub periodcentered by anoteleia;
} MFBGreekPunctuationLocal;

lookup MFBGreekPunctuationSmallcaps {
    sub anoteleia by anoteleia.sc;
} MFBGreekPunctuationSmallcaps;

lookup MFBGreekPunctuationAllcaps {
    sub anoteleia by anoteleia.allcaps;
} MFBGreekPunctuationAllcaps;

lookup MFBGreekPunctuationCapitalContext {
    lookupflag IgnoreMarks;
    sub @MFBGreekPunctuationCapitals anoteleia' by anoteleia.allcaps;
} MFBGreekPunctuationCapitalContext;

# Prefix: MFB Greek Accent Stack Classes
markClass acutecomb <anchor 193 494> @MFBGreekRawAcute;
markClass acutecomb.sc <anchor 193 494> @MFBGreekRawAcute;
markClass acutecomb.allcaps <anchor 193 494> @MFBGreekRawAcute;
markClass gravecomb <anchor 319 494> @MFBGreekRawGrave;
markClass gravecomb.sc <anchor 319 494> @MFBGreekRawGrave;
markClass gravecomb.allcaps <anchor 319 494> @MFBGreekRawGrave;
markClass perispomenicomb <anchor 283 494> @MFBGreekRawPerispomeni;
markClass perispomenicomb.sc <anchor 283 494> @MFBGreekRawPerispomeni;
markClass perispomenicomb.allcaps <anchor 283 494> @MFBGreekRawPerispomeni;

# Prefix: MFB Greek Editorial Dot Order
@MFBGreekEditorialDotMarks = [dotbelowcomb];
lookup MFBGreekAdscriptToEditorialDot {
    sub [iota.spacingadscript.sc Iota.spacingadscript.allcaps] by dotbelowcomb;
} MFBGreekAdscriptToEditorialDot;
lookup MFBGreekEditorialDotToSmallAdscript {
    sub dotbelowcomb by iota.spacingadscript.sc;
} MFBGreekEditorialDotToSmallAdscript;
lookup MFBGreekEditorialDotToFullAdscript {
    sub dotbelowcomb by Iota.spacingadscript.allcaps;
} MFBGreekEditorialDotToFullAdscript;
lookup MFBGreekEditorialDotOrder {
    lookupflag UseMarkFilteringSet @MFBGreekEditorialDotMarks;
    sub iota.spacingadscript.sc' lookup MFBGreekAdscriptToEditorialDot dotbelowcomb' lookup MFBGreekEditorialDotToSmallAdscript;
    sub Iota.spacingadscript.allcaps' lookup MFBGreekAdscriptToEditorialDot dotbelowcomb' lookup MFBGreekEditorialDotToFullAdscript;
} MFBGreekEditorialDotOrder;

