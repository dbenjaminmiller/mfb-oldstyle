feature ccmp {
# BEGIN MFB GREEK POLYTONIC
script grek;
language dflt;
lookup MFBGreekDecompose;
lookup MFBGreekLengthSwap0;
lookup MFBGreekLengthExpand0;
lookup MFBGreekLengthSwap1;
lookup MFBGreekLengthExpand1;
lookup MFBGreekLengthSwap2;
lookup MFBGreekLengthExpand2;
lookup MFBGreekLengthSwap3;
lookup MFBGreekLengthExpand3;
lookup MFBGreekLengthSwap4;
lookup MFBGreekLengthExpand4;
lookup MFBGreekLengthSwap5;
lookup MFBGreekLengthExpand5;
lookup MFBGreekBreathingAccent;
lookup MFBGreekAdscript;
lookup MFBGreekDiaeresisAccent;
lookup MFBGreekCapitalCompose;
# BEGIN MFB GREEK INITIAL LENGTH SPACING
lookup MFBGreekInitialLengthSpacing;
# END MFB GREEK INITIAL LENGTH SPACING
lookup MFBGreekCapitalFallback;
script DFLT;
language dflt;
# END MFB GREEK POLYTONIC
lookup ccmp_DFLT_1 {
	lookupflag 0;
	sub brevecomb acutecomb by brevecomb_acutecomb;
	sub brevecomb gravecomb by brevecomb_gravecomb;
	sub brevecomb hookabovecomb by brevecomb_hookabovecomb;
	sub brevecomb tildecomb by brevecomb_tildecomb;
	sub circumflexcomb acutecomb by circumflexcomb_acutecomb;
	sub circumflexcomb caroncomb by circumflexcomb_caroncomb;
	sub circumflexcomb gravecomb by circumflexcomb_gravecomb;
	sub circumflexcomb hookabovecomb by circumflexcomb_hookabovecomb;
	sub circumflexcomb tildecomb by circumflexcomb_tildecomb;
} ccmp_DFLT_1;

lookup ccmp_Other_1 {
	@CombiningTopAccents = [acutecomb brevecomb breveinvertedcomb candraBinducomb caroncomb circumflexcomb commaturnedabovecomb dblgravecomb dieresiscomb dotaccentcomb gravecomb hookabovecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub i' @CombiningTopAccents by idotless;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_Other_1;

lookup ccmp_latn_1 {
	lookupflag 0;
