lookup MFBGreekSmallcapsSuppressMarks {
    lookupflag UseMarkFilteringSet @MFBGreekSmallcapsAccentInputs;
    sub @MFBGreekSmallcapsBases @MFBGreekSmallcapsHide' by mfbGreekSmallcapsNoAccent.sc;
    sub @MFBGreekSmallcapsBases @MFBGreekSmallcapsKeepDiaeresis' by dieresiscomb.grek.sc;
} MFBGreekSmallcapsSuppressMarks;

lookup MFBGreekSmallcapsAdscript {
    lookupflag UseMarkFilteringSet @MFBGreekSmallcapsYpo;
    sub @MFBGreekSmallcapsBases ypogegrammenicomb' by iota.spacingadscript.sc;
} MFBGreekSmallcapsAdscript;

