# END MFB ITALIC EXISTING DIAERESIS
    sub [alphaoxia.sc alphatonos.sc epsilonoxia.sc epsilontonos.sc etaoxia.sc etatonos.sc iotaoxia.sc iotatonos.sc omegaoxia.sc omegatonos.sc omicronoxia.sc omicrontonos.sc upsilonoxia.sc upsilontonos.sc] iota.sc' by iotadieresis.sc;
    sub [alpha.sc epsilon.sc eta.sc iota.sc omega.sc omicron.sc upsilon.sc] [acutecomb acutecomb.sc] iota.sc' by iotadieresis.sc;
    sub [alphaoxia.sc alphatonos.sc epsilonoxia.sc epsilontonos.sc etaoxia.sc etatonos.sc iotaoxia.sc iotatonos.sc omegaoxia.sc omegatonos.sc omicronoxia.sc omicrontonos.sc upsilonoxia.sc upsilontonos.sc] upsilon.sc' by upsilondieresis.sc;
    sub [alpha.sc epsilon.sc eta.sc iota.sc omega.sc omicron.sc upsilon.sc] [acutecomb acutecomb.sc] upsilon.sc' by upsilondieresis.sc;
} MFBGreekSmallcapsHiatus;

