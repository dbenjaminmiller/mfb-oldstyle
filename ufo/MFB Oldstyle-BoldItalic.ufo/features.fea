# END MFB ITALIC EXISTING DIAERESIS
    sub [Alphaoxia Alphaoxia.allcaps Alphatonos Alphatonos.allcaps Epsilonoxia Epsilonoxia.allcaps Epsilontonos Epsilontonos.allcaps Etaoxia Etaoxia.allcaps Etatonos Etatonos.allcaps Iotaoxia Iotaoxia.allcaps Iotatonos Iotatonos.allcaps Omegaoxia Omegaoxia.allcaps Omegatonos Omegatonos.allcaps Omicronoxia Omicronoxia.allcaps Omicrontonos Omicrontonos.allcaps Upsilonoxia Upsilonoxia.allcaps Upsilontonos Upsilontonos.allcaps] Iota' by Iotadieresis.allcaps;
    sub [Alpha Epsilon Eta Iota Omega Omicron Upsilon] [acutecomb acutecomb.sc acutecomb.case acutecomb.allcaps] Iota' by Iotadieresis.allcaps;
    sub [Alphaoxia Alphaoxia.allcaps Alphatonos Alphatonos.allcaps Epsilonoxia Epsilonoxia.allcaps Epsilontonos Epsilontonos.allcaps Etaoxia Etaoxia.allcaps Etatonos Etatonos.allcaps Iotaoxia Iotaoxia.allcaps Iotatonos Iotatonos.allcaps Omegaoxia Omegaoxia.allcaps Omegatonos Omegatonos.allcaps Omicronoxia Omicronoxia.allcaps Omicrontonos Omicrontonos.allcaps Upsilonoxia Upsilonoxia.allcaps Upsilontonos Upsilontonos.allcaps] Upsilon' by Upsilondieresis.allcaps;
    sub [Alpha Epsilon Eta Iota Omega Omicron Upsilon] [acutecomb acutecomb.sc acutecomb.case acutecomb.allcaps] Upsilon' by Upsilondieresis.allcaps;
} MFBGreekAllcapsHiatus;

